      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "alt",
      "widget": "ostler.tile",
      "bind": {
       "path": "Vehicle.CurrentLocation.Altitude"
      },
      "style": "number",
      "label": "Altitude",
      "unit": "m",
      "dec": 0,
      "at": [
       0,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "hdg",
      "widget": "ostler.compass",
      "bind": {
       "path": "Vehicle.CurrentLocation.Heading"
      },
      "style": "compass",
      "label": "Heading",
      "at": [
       2,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "s",
      "widget": "ostler.tile",
      "bind": {
       "path": "Vehicle.Speed"
      },
      "style": "number",
      "unit": "km/h",
      "label": "Speed",
      "dec": 0,
