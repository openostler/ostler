       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "roll",
      "widget": "ostler.inclinometer",
      "bind": {
       "path": "Vehicle.Orientation.Roll"
      },
      "style": "inclinometer",
      "label": "Roll",
      "config": {
       "view": "rear"
      },
      "at": [
       2,
       0
      ],
