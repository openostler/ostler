  "hu5": [
   {
    "face": "map",
    "name": "Map",
    "grid": {
     "cols": 6,
     "rows": 4
    },
    "widgets": [
     {
      "slot": "m",
      "widget": "ostler.map",
      "label": "Map",
      "config": {
       "follow": "heading_up",
       "trail": "trip",
       "layers": []
      },
      "at": [
       0,
       0
      ],
      "span": [
       6,
       4
      ],
      "size": "wide"
     },
     {
      "slot": "s",
      "widget": "ostler.tile",
      "bind": {
       "path": "Vehicle.Speed"
      },
      "style": "number",
      "unit": "km/h",
      "label": "Speed",
      "dec": 0,
      "at": [
       0,
       0
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "alt",
      "widget": "ostler.tile",
      "bind": {
       "path": "Vehicle.CurrentLocation.Altitude"
      },
      "style": "number",
      "label": "Altitude",
      "unit": "m",
      "dec": 0,
      "at": [
       0,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "hdg",
      "widget": "ostler.compass",
      "bind": {
       "path": "Vehicle.CurrentLocation.Heading"
      },
      "style": "compass",
      "label": "Heading",
      "at": [
       4,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     }
    ],
    "moving": {
     "show": [
      "m",
      "s",
      "alt",
      "hdg"
     ],
     "grid": {
      "cols": 3,
      "rows": 2
     },
     "place": {
      "m": [
       0,
       0,
       3,
       2
      ],
      "s": [
