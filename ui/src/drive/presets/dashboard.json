 "classes": {
  "hu5": [
   {
    "face": "cluster",
    "name": "Cluster",
    "grid": {
     "cols": 6,
     "rows": 4
    },
    "widgets": [
     {
      "slot": "cool",
      "widget": "ostler.gauge",
      "bind": {
       "path": "Vehicle.Powertrain.CombustionEngine.EngineCoolant.Temperature"
      },
      "style": "bar",
      "label": "Coolant",
      "dec": 0,
      "levels": {
       "warning": [
        105,
        112
       ],
       "critical": [
        112,
        null
       ]
      },
      "at": [
       0,
       0
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "spd",
      "widget": "ostler.hero",
      "bind": {
       "path": "Vehicle.Speed"
      },
      "style": "arc",
      "unit": "km/h",
      "label": "Speed",
      "dec": 0,
      "range": [
       0,
       160
      ],
      "at": [
       2,
       0
      ],
      "span": [
       2,
       4
      ],
      "size": "small"
     },
     {
      "slot": "boost",
      "widget": "ostler.gauge",
      "bind": {
       "path": "Vehicle.Powertrain.CombustionEngine.MAP"
      },
      "style": "bar",
      "label": "Boost",
      "at": [
       4,
       0
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "batt",
      "widget": "ostler.gauge",
      "bind": {
       "path": "Vehicle.LowVoltageBattery.CurrentVoltage"
      },
      "style": "bar",
      "label": "Battery",
      "dec": 1,
      "at": [
       0,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     },
     {
      "slot": "rpm",
      "widget": "ostler.gauge",
      "bind": {
       "path": "Vehicle.Powertrain.CombustionEngine.Speed"
      },
      "style": "bar",
      "label": "Engine",
      "dec": 0,
      "refresh_hz": 4,
      "at": [
       4,
       2
      ],
      "span": [
       2,
       2
      ],
      "size": "small"
     }
    ],
    "moving": {
     "show": [
      "cool",
      "spd",
      "boost",
      "batt",
      "rpm"
     ],
     "grid": {
      "cols": 3,
      "rows": 2
     },
     "place": {
      "cool": [
       0,
       0,
       1,
       1
      ],
      "spd": [
       1,
       0,
       1,
       2
      ],
      "boost": [
       2,
       0,
       1,
       1
      ],
      "batt": [
       0,
       1,
       1,
       1
      ],
      "rpm": [
       2,
       1,
       1,
       1
      ]
     }
    }
   },
   {
    "face": "map",
    "name": "Map",
    "grid": {
     "cols": 6,
     "rows": 4
    },
    "widgets": [
     {
      "slot": "m",
      "widget": "ostler.map",
      "label": "Map",
      "config": {
       "follow": "heading_up",
       "trail": "trip",
