{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostler.tech/schemas/session-meta.schema.json",
  "title": "Logbook session meta",
  "description": "meta.json of one recorded session (<logs>/sessions/<id>/meta.json), written atomically by openostler.logbook.recorder (ADR-0009, ADR-0010, ADR-0011, U0). Timestamps are RFC 3339 in UTC with a Z suffix. Sessions recorded before U0 carry no vid; the store reads them as the local vid and never rewrites them. note_count is computed on read and is not stored. Sessions recorded from a node (source node; NodeSource spec §7) add devices, device_info, pack, tap and end_reason.",
  "type": "object",
  "required": ["id", "start_utc", "end_utc", "duration_s", "rows", "parts", "modules", "channels",
               "has_gps", "distance_km", "max_speed_kmh", "bbox", "start_pos", "end_pos",
               "synthetic", "recording", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z(-[0-9]+)?$" },
    "vid": { "$ref": "#/$defs/vid" },
    "name": { "type": ["string", "null"], "maxLength": 80 },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "place_start": { "$ref": "#/$defs/place" },
    "place_end": { "$ref": "#/$defs/place" },
    "place": { "$ref": "#/$defs/place" },
    "start_utc": { "$ref": "#/$defs/utc" },
    "end_utc": { "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
    "duration_s": { "type": "integer", "minimum": 0 },
    "rows": { "type": "integer", "minimum": 0 },
    "parts": { "type": "array", "items": { "type": "string", "pattern": "^data(-[0-9]+)?\\.csv$" } },
    "modules": { "type": "array", "items": { "type": "string" } },
    "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "has_gps": { "type": "boolean" },
    "distance_km": { "type": "number", "minimum": 0 },
    "max_speed_kmh": { "type": ["number", "null"] },
    "bbox": {
      "oneOf": [
        { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        { "type": "null" }
      ],
      "description": "[min lon, min lat, max lon, max lat]."
    },
    "start_pos": { "$ref": "#/$defs/lonlat" },
    "end_pos": { "$ref": "#/$defs/lonlat" },
    "synthetic": { "type": "boolean" },
    "recording": { "type": "boolean" },
    "source": { "type": "string", "description": "live, node (recorded from a node's MQTT messages), demo, or a legacy mock." },
    "devices": { "type": "array", "items": { "type": "string" }, "description": "A node session: the device ids seen under the vehicle id." },
    "device_info": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fw", "etag"],
        "properties": { "fw": { "type": ["string", "null"] }, "etag": { "type": ["string", "null"] } }
      },
      "description": "A node session: each device's firmware version and capability-manifest etag, from its retained manifest (the latest seen; every change is a node_manifest event). Devices with no manifest are absent."
    },
    "pack": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string" }, "version": { "type": ["string", "null"] } }
        },
        { "type": "null" }
      ],
      "description": "A node session: the vehicle pack (and its distribution version) that decoded it on the Brain."
    },
    "tap": { "type": "array", "items": { "$ref": "#/$defs/tap" }, "description": "A node session: its raw-tap files (tap/<tap session>.otap)." },
    "end_reason": {
      "oneOf": [{ "enum": ["idle", "node_asleep", "closed", "split"] }, { "type": "null" }],
      "description": "A node session: why it ended (null while recording). node_asleep: the node slept cleanly; idle: 300 s without a connected poll; closed: the server stopped; split: a manual split."
    },
    "audio": { "type": "array", "items": { "$ref": "#/$defs/audio" } },
    "accel_cal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["matrix"],
          "properties": {
            "matrix": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
            },
            "source": { "type": "string" },
            "method": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "vid": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{0,63}$",
      "description": "Vehicle id: names one vehicle, not a pack (UI spec §4.1)."
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 timestamp in UTC with a Z suffix."
    },
    "lonlat": {
      "oneOf": [
        { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        { "type": "null" }
      ],
      "description": "[longitude, latitude] (GeoJSON order)."
    },
    "place": {
      "oneOf": [
        {
          "type": "object",
          "required": ["label", "source"],
          "properties": {
            "label": { "type": "string" },
            "source": { "type": "string" },
            "label_offline": { "type": ["string", "null"] }
          }
        },
        { "type": "null" }
      ]
    },
    "channel": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "units": { "type": "string" },
        "group": { "type": "string" },
        "c": { "enum": ["proven", "candidate"] },
        "limits": {
          "oneOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            { "type": "null" }
          ]
        }
      }
    },
    "tap": {
      "type": "object",
      "required": ["session", "device", "file", "scrub", "seq_first", "seq_last", "gaps", "overflow"],
      "properties": {
        "session": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "The node's tap session (a ULID)." },
        "device": { "type": "string" },
        "file": { "type": "string", "pattern": "^tap/[0-9A-Za-z_.-]+\\.otap$" },
        "boot_id": { "type": ["integer", "null"] },
        "scrub": {
          "oneOf": [{ "enum": ["on", "brain", "off", "unknown"] }, { "type": "null" }],
          "description": "on: the node scrubbed and the Brain re-checked; brain: the Brain scrubbed (the node's header said off or nothing); off / unknown: identity data kept on this device under the install option OSTLER_RECORD_IDENTITY (ADR-0036; never exported)."
        },
        "buses": { "type": "array", "items": { "type": "object" } },
        "clock": { "type": ["object", "null"] },
        "started": { "type": ["string", "null"] },
        "seq_first": { "type": ["integer", "null"], "minimum": 0 },
        "seq_last": { "type": ["integer", "null"], "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0, "description": "seq gaps (each logged as a tap_gap event; never filled)." },
        "lost": { "type": "integer", "minimum": 0 },
        "overflow": { "type": "integer", "minimum": 0, "description": "overflow events from the node." },
        "time_marks": { "type": "integer", "minimum": 0, "description": "time events from the node (raw-tap §2.4): with at least one, readers map t_us to UTC; none keeps the node's clock only." },
        "refused": { "type": "integer", "minimum": 0, "description": "batches refused whole for another MQTT 5 content type than application/vnd.ostler.tap.v1 (module-bus spec §8); their records read as a gap." },
        "unlabelled": { "type": "integer", "minimum": 0, "description": "batches without a content type or a readable first_seq (a node from before the firmware set them), read as v1 by their records." },
        "first_seq_mismatch": { "type": "integer", "minimum": 0, "description": "batches whose first_seq user property disagreed with their first record's seq (each a tap_error event; the records' seq is kept)." },
        "brain_scrubbed": { "type": "integer", "minimum": 0 },
        "brain_dropped": { "type": "integer", "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "required": ["track"],
      "properties": {
        "track": { "type": "string" },
        "mime": { "type": "string" },
        "start_ms": { "type": ["integer", "null"] },
        "end_ms": { "type": ["integer", "null"] },
        "source": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
